# ─── Sitio ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.todouncubo.com

# Enlace de tu canal de YouTube (botones "Visitar canal")
NEXT_PUBLIC_YOUTUBE_URL=

# ─── Supabase (Project Settings → API) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡SOLO servidor! Nunca la prefijes con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ─── YouTube ──────────────────────────────────────────────
# ID del canal (empieza por UC...). Obligatorio para la sincronización.
YOUTUBE_CHANNEL_ID=
# Opcional: YouTube Data API v3. Sin clave se usa el feed RSS público (últimos 15 videos).
YOUTUBE_API_KEY=

# Secreto que protege /api/youtube/sync (cron) — genera uno largo y aleatorio
CRON_SECRET=
# Secreto HMAC para las notificaciones push de YouTube (WebSub)
WEBSUB_SECRET=

# ─── Google AdSense (opcional) ────────────────────────────
# Ej: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
